# =============================================================
# BOTTLENECK LAB — Environment Variables
# =============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to source control.
# =============================================================

# --- Supabase (required for authentication and persistence) ---
# Found in your Supabase project: Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# --- Cloudflare Turnstile CAPTCHA (optional — production only) ---
# Get a site key from https://dash.cloudflare.com/?to=/:account/turnstile
# The SECRET key must NEVER go in frontend code — use a Supabase Edge Function.
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key-here

# --- App Mode ---
# Leave empty for auto-detection based on Supabase config presence.
# Set to "demo" to force demo mode regardless of Supabase config.
VITE_APP_MODE=

# =============================================================
# SETUP INSTRUCTIONS
# =============================================================
# 1. Create a free Supabase project at https://supabase.com
# 2. In your Supabase project, go to Settings → API
#    Copy the Project URL and anon/public key into this file.
# 3. In Supabase, go to SQL Editor and run the contents of:
#    supabase/migrations/001_initial_schema.sql
# 4. In Supabase Auth settings:
#    - Enable email/password sign-ins
#    - Set Site URL to http://localhost:5173 (dev) or your production URL
#    - Add http://localhost:5173 to Redirect URLs
# 5. Optionally configure email templates in Supabase Auth → Email Templates
# 6. Copy this file: cp .env.example .env
# 7. Fill in your real values in .env
# 8. Run: npm install && npm run dev
# =============================================================
